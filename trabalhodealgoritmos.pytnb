        "<a href=\"https://colab.research.google.com/github/matheusbg006/algoritmos2/blob/main/trabalhodealgoritmos.pytnb\" target=\"_parent\"><img src=\"https://colab.research.google.com/assets/colab-badge.svg\" alt=\"Open In Colab\"/></a>"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "import random\n",
        "\n",
        "def simulador_adivinhacao():\n",
        "    lista = random.sample(range(1, 101), 20)\n",
        "    lista.sort()\n",
        "\n",
        "    print(\"--- Lista de Números Disponíveis ---\")\n",
        "    print(lista)\n",
        "    print(\"-\" * 36)\n",
        "\n",
        "    alvo = random.choice(lista)\n",
        "    print(f\"O computador deve encontrar o número: {alvo}\")\n",
        "\n",
        "    inicio = 0\n",
        "    fim = len(lista) - 1\n",
        "    passos = 0\n",
        "    posicao = -1\n",
        "\n",
        "    while inicio <= fim:\n",
        "        passos += 1\n",
        "        meio = (inicio + fim) // 2\n",
        "        chute = lista[meio]\n",
        "\n",
        "        if chute == alvo:\n",
        "            posicao = meio\n",
        "            break\n",
        "        elif chute > alvo:\n",
        "            fim = meio - 1\n",
        "        else:\n",
        "            inicio = meio + 1\n",
        "\n",
        "    #Exibição dos resultados\n",
        "    if posicao != -1:\n",
        "        print(f\"\\n✅ Número encontrado!\")\n",
        "        print(f\"• Número escolhido: {alvo}\")\n",
        "        print(f\"• Posição na lista (índice): {posicao}\")\n",
        "        print(f\"• Quantidade de passos necessários: {passos}\")\n",
        "    else:\n",
        "        print(\"\\n❌ Número não encontrado.\")\n",
        "\n",
        "# Chamar a função para executar\n",
        "simulador_adivinhacao()"
      ],
      "metadata": {
